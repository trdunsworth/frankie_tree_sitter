{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Frankie",
  "scopeName": "source.frankie",
  "patterns": [
    { "include": "#comment" },
    { "include": "#heredoc" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#symbol" },
    { "include": "#keyword" },
    { "include": "#boolean" },
    { "include": "#constant" },
    { "include": "#function-builtin" },
    { "include": "#type" },
    { "include": "#operator" },
    { "include": "#function-call" },
    { "include": "#identifier" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "match": "#[^\\n]*",
      "name": "comment.line.number-sign.frankie"
    },
    "heredoc": {
      "name": "string.unquoted.heredoc.frankie",
      "begin": "(<<~?)([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.string.begin.frankie" },
        "2": { "name": "entity.name.type.frankie" }
      },
      "end": "^\\s*\\2\\s*$",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.frankie" }
      },
      "patterns": [
        { "include": "#string-interpolation" }
      ]
    },
    "string": {
      "patterns": [
        { "include": "#string-triple-double" },
        { "include": "#string-triple-single" },
        { "include": "#string-double" },
        { "include": "#string-single" }
      ]
    },
    "string-triple-double": {
      "name": "string.quoted.triple.frankie",
      "begin": "\"\"\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.frankie" }
      },
      "end": "\"\"\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.frankie" }
      },
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#string-interpolation" }
      ]
    },
    "string-triple-single": {
      "name": "string.quoted.triple.single.frankie",
      "begin": "'''",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.frankie" }
      },
      "end": "'''",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.frankie" }
      },
      "patterns": [
        { "include": "#string-escape" }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.frankie",
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.frankie" }
      },
      "end": "\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.frankie" }
      },
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#string-interpolation" }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.frankie",
      "begin": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.frankie" }
      },
      "end": "'",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.frankie" }
      },
      "patterns": [
        { "include": "#string-escape" }
      ]
    },
    "string-escape": {
      "match": "\\\\(?:[\\\\'\"nrtbfv0]|u[0-9a-fA-F]{4})",
      "name": "constant.character.escape.frankie"
    },
    "string-interpolation": {
      "name": "meta.interpolation.frankie",
      "begin": "#\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.frankie" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.frankie" }
      },
      "patterns": [
        { "include": "$self" }
      ]
    },
    "number": {
      "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?",
      "name": "constant.numeric.frankie"
    },
    "symbol": {
      "match": ":[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "constant.other.symbol.frankie"
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(?:begin|break|case|do|else|elsif|end|ensure|for|if|in|loop|next|not|or|rescue|return|then|unless|until|when|while|and)\\b",
          "name": "keyword.control.frankie"
        },
        {
          "match": "\\b(?:def|const|import|record|as|await)\\b",
          "name": "keyword.other.frankie"
        }
      ]
    },
    "boolean": {
      "match": "\\b(?:true|false)\\b",
      "name": "constant.language.boolean.frankie"
    },
    "constant": {
      "match": "\\bnil\\b",
      "name": "constant.language.nil.frankie"
    },
    "function-builtin": {
      "match": "\\b(?:puts|print|raise|require|stitch)\\b",
      "name": "support.function.builtin.frankie"
    },
    "type": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.frankie"
    },
    "operator": {
      "match": "\\*\\*=|\\|\\|=|//\\=?|\\*\\=|/=|%=|\\+=|-=|==|!=|<=|>=|=~|&&|\\|\\||\\*\\*|&\\.|\\|>|\\.\\.\\.|->|\\.\\.|[+\\-*/%&|<>?=]",
      "name": "keyword.operator.frankie"
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*[?!]?)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.frankie" }
      }
    },
    "identifier": {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*[?!]?",
      "name": "variable.other.frankie"
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[\\[\\](){}]",
          "name": "punctuation.bracket.frankie"
        },
        {
          "match": "[,;:.]",
          "name": "punctuation.delimiter.frankie"
        }
      ]
    }
  }
}
