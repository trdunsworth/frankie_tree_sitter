{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ],
  "wordPattern": "([a-zA-Z_][a-zA-Z0-9_]*[?!]?)|(:[a-zA-Z_][a-zA-Z0-9_]*)|(-?[0-9][0-9_]*(\\.[0-9]+)?)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(def|if|unless|while|until|for|loop|case|begin|do|else|elsif|ensure|rescue|when)\\b",
    "decreaseIndentPattern": "^\\s*(end|else|elsif|ensure|rescue|when)\\b"
  },
  "folding": {
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  }
}
