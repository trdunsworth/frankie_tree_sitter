{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "frankie",
      "camelcase": "Frankie",
      "title": "Frankie",
      "scope": "source.frankie",
      "file-types": [
        "fk"
      ],
      "injection-regex": "^frankie$",
      "class-name": "TreeSitterFrankie",
      "highlights": [
        "queries/highlights.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Frankie Programming Language parser",
    "authors": [
      {
        "name": "Tony Dunsworth",
        "email": "tony.dunsworth@gmail.com",
        "url": "https://drddatascience.com"
      }
    ],
    "links": {
      "repository": "https://github.com/trdunsworth/frankie_tree_sitter",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
