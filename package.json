{
  "name": "tree-sitter-frankie",
  "version": "0.1.0",
  "description": "Frankie Programming Language parser",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trdunsworth/frankie_tree_sitter.git"
  },
  "funding": "",
  "license": "MIT",
  "author": {
    "name": "Tony Dunsworth",
    "email": "tony.dunsworth@gmail.com",
    "url": "https://drddatascience.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "frankie"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.27.0",
    "web-tree-sitter": "^0.27.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "npm run build:wasm",
    "start": "tree-sitter playground",
    "build:wasm": "tree-sitter build --wasm",
    "test": "tree-sitter test && node --test bindings/node/*_test.js",
    "test:examples": "bash scripts/check-examples.sh",
    "test:wasm": "npm run build:wasm && node scripts/check-wasm.mjs",
    "test:vscode": "npm --prefix vscode test"
  }
}
